# Multi-stage Dockerfile for Autonomous Vulnerability Research Platform
FROM golang:1.24-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o /app/bin/api ./cmd/api && \
    CGO_ENABLED=0 GOOS=linux go build -o /app/bin/cli ./cmd/cli

# Production runtime image
FROM alpine:3.20

RUN apk add --no-cache ca-certificates git curl bash

WORKDIR /app

COPY --from=builder /app/bin/api /app/bin/api
COPY --from=builder /app/bin/cli /app/bin/cli
COPY --from=builder /app/configs /app/configs
COPY --from=builder /app/prompts /app/prompts
COPY --from=builder /app/schemas /app/schemas
COPY --from=builder /app/migrations /app/migrations
COPY --from=builder /app/web /app/web

ENV PATH="/app/bin:${PATH}"
EXPOSE 8080

ENTRYPOINT ["/app/bin/api"]
CMD ["-config", "configs/config.docker.yaml"]
