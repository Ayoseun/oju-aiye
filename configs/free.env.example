# Presets for free online model endpoints. Copy to configs/free.env (git-ignored), keep ONE
# block uncommented, then:
#
#   source configs/free.env && make run-api-free
#
# The platform sends your repository's source code to whichever endpoint you choose. Check the
# provider's data-retention terms before pointing it at anything you care about.
#
# ------------------------------------------------------------------------------
# 1. Pollinations - no signup, no API key, no card. The default in config.free.yaml.
#    The anonymous tier exposes exactly ONE model: "openai-fast" (GPT-OSS 20B, a reasoning
#    model), at 1 reply per 45 seconds per IP. Expect an audit to take several minutes and
#    the occasional retry; the platform retries rate limits and reports truncation clearly.
# ------------------------------------------------------------------------------
export SCOUT_BASE_URL=https://text.pollinations.ai/openai
export INVESTIGATOR_BASE_URL=https://text.pollinations.ai/openai
export REVIEWER_BASE_URL=https://text.pollinations.ai/openai
export SCOUT_MODEL_ID=openai-fast
export INVESTIGATOR_MODEL_ID=openai-fast
export REVIEWER_MODEL_ID=openai-fast
# (leave the API key variables unset; this endpoint ignores them)

# ------------------------------------------------------------------------------
# 2. OpenRouter - no card. 25+ models tagged ":free".
#    Limits: 20 requests/minute, 50 requests/day (1000/day once you have bought $10 of credits).
#    Free model ids rotate often; list them live with:
#      curl -s https://openrouter.ai/api/v1/models | jq -r '.data[].id' | grep ':free$'
#    Give the Reviewer a DIFFERENT model than the Investigator: sharing one model means the
#    Reviewer and the Investigator share blind spots.
# ------------------------------------------------------------------------------
# export OPENROUTER_API_KEY=sk-or-...
# export SCOUT_BASE_URL=https://openrouter.ai/api/v1
# export INVESTIGATOR_BASE_URL=https://openrouter.ai/api/v1
# export REVIEWER_BASE_URL=https://openrouter.ai/api/v1
# export SCOUT_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b:free
# export INVESTIGATOR_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b:free
# export REVIEWER_MODEL_ID=google/gemma-4-31b-it:free
# export SCOUT_API_KEY=$OPENROUTER_API_KEY
# export INVESTIGATOR_API_KEY=$OPENROUTER_API_KEY
# export REVIEWER_API_KEY=$OPENROUTER_API_KEY

# ------------------------------------------------------------------------------
# 3. Groq - free tier with per-model daily request caps. Fast.
#    Model list: https://console.groq.com/docs/models
# ------------------------------------------------------------------------------
# export GROQ_API_KEY=gsk_...
# export SCOUT_BASE_URL=https://api.groq.com/openai/v1
# export INVESTIGATOR_BASE_URL=https://api.groq.com/openai/v1
# export REVIEWER_BASE_URL=https://api.groq.com/openai/v1
# export SCOUT_MODEL_ID=openai/gpt-oss-120b
# export INVESTIGATOR_MODEL_ID=openai/gpt-oss-120b
# export REVIEWER_MODEL_ID=openai/gpt-oss-20b
# export SCOUT_API_KEY=$GROQ_API_KEY
# export INVESTIGATOR_API_KEY=$GROQ_API_KEY
# export REVIEWER_API_KEY=$GROQ_API_KEY

# ------------------------------------------------------------------------------
# 4. Requesty - no card, 200 requests/day across the free models, OpenAI-compatible gateway.
#    Model list: https://docs.requesty.ai/features/free-models
# ------------------------------------------------------------------------------
# export REQUESTY_API_KEY=...
# export SCOUT_BASE_URL=https://router.requesty.ai/v1
# export INVESTIGATOR_BASE_URL=https://router.requesty.ai/v1
# export REVIEWER_BASE_URL=https://router.requesty.ai/v1
# export SCOUT_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
# export INVESTIGATOR_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
# export REVIEWER_MODEL_ID=google/gemma-4-31b-it
# export SCOUT_API_KEY=$REQUESTY_API_KEY
# export INVESTIGATOR_API_KEY=$REQUESTY_API_KEY
# export REVIEWER_API_KEY=$REQUESTY_API_KEY

# ------------------------------------------------------------------------------
# 5. NVIDIA NIM (build.nvidia.com) - free credits on signup, OpenAI-compatible.
#    Model list: https://build.nvidia.com/models
# ------------------------------------------------------------------------------
# export NVIDIA_API_KEY=nvapi-...
# export SCOUT_BASE_URL=https://integrate.api.nvidia.com/v1
# export INVESTIGATOR_BASE_URL=https://integrate.api.nvidia.com/v1
# export REVIEWER_BASE_URL=https://integrate.api.nvidia.com/v1
# export SCOUT_MODEL_ID=nvidia/llama-3.1-nemotron-70b-instruct
# export INVESTIGATOR_MODEL_ID=nvidia/llama-3.1-nemotron-70b-instruct
# export REVIEWER_MODEL_ID=nvidia/llama-3.1-nemotron-70b-instruct
# export SCOUT_API_KEY=$NVIDIA_API_KEY
# export INVESTIGATOR_API_KEY=$NVIDIA_API_KEY
# export REVIEWER_API_KEY=$NVIDIA_API_KEY

# ------------------------------------------------------------------------------
# 6. Google AI Studio (Gemini) - free tier, OpenAI-compatible.
#    NOTE: this endpoint is https://generativelanguage.googleapis.com/v1beta/openai and it does
#    NOT end in /v1, which the adapter's URL join does not handle: it would build
#    ".../v1beta/openai/v1/chat/completions" and get a 404. Use a reverse proxy that appends
#    /v1, or point at another provider.
# ------------------------------------------------------------------------------
# export GEMINI_API_KEY=...
# export SCOUT_BASE_URL=https://your-proxy.example.com/v1
# export SCOUT_MODEL_ID=gemini-2.5-flash
# export SCOUT_API_KEY=$GEMINI_API_KEY
