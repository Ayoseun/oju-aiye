# Copy to configs/gpu.env (git-ignored), fill in, then: source configs/gpu.env && make run-api-gpu
#
# Reaching the GPU box. Pick ONE:
#   SSH tunnel (recommended):  ssh -N -L 11434:localhost:11434 you@your-gpu-host
#                              GPU_BASE_URL=http://localhost:11434/v1
#   https reverse proxy:       GPU_BASE_URL=https://llm.example.com/v1   (and set GPU_API_KEY)
#   WireGuard / Tailscale:     GPU_BASE_URL=http://100.x.y.z:11434/v1    (and add allow_insecure_http: true
#                              to each model in config.gpu.yaml, because it is plain http on a private network)
export GPU_BASE_URL=http://localhost:11434/v1
# Only needed if the endpoint checks a key (a reverse proxy). Ollama itself ignores it.
export GPU_API_KEY=

# Model tags exactly as `ollama list` shows them on the GPU box.
export GPU_LEAD_MODEL=
export GPU_SCOUT_MODEL=
export GPU_INVESTIGATOR_MODEL=
export GPU_REVIEWER_MODEL=
